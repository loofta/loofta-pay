# Railway deploy from monorepo root: build and run apps/backend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy backend manifests (both files needed for npm ci to pin exact versions)
COPY apps/backend/package.json apps/backend/package-lock.json ./
RUN npm ci --legacy-peer-deps

# @onsol/tldparser (used for .skr Seeker ID lookups) declares "borsh": "^2.0.0", but npm hoists
# the root's own borsh@0.7.0 (needed by @coral-xyz/anchor) over it instead, which throws
# "schema.get is not a function" at runtime. In local dev this is fixed by the monorepo root's
# postinstall hook (patches/fix-tldparser-borsh.js) — but this build installs apps/backend
# standalone from the monorepo root and never runs that hook, so prod silently kept the broken
# version. Same fix, applied explicitly here.
COPY patches ./patches
RUN node patches/fix-tldparser-borsh.js

# Copy backend source
COPY apps/backend .

# Build
RUN npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/healthz || exit 1

CMD ["node", "dist/main"]
