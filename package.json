{
  "name": "loofta-swap",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@loofta/frontend",
    "dev:backend": "npm run start:dev --workspace=@loofta/backend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=@loofta/frontend",
    "build:backend": "npm run build --workspace=@loofta/backend",
    "build:all": "npm run build --workspaces",
    "start": "npm run start --workspace=@loofta/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@loofta/backend",
    "postinstall": "patch-package && node patches/fix-tldparser-borsh.js",
    "prepare": "husky"
  },
  "overrides": {
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "9.1.7",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
