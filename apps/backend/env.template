# ===========================================
# Loofta Swap Backend - Environment Variables
# ===========================================
# COPY THIS FILE TO .env.local and fill in the values
# cp env.template .env.local

# Server Configuration
PORT=3001
NODE_ENV=development

# ===========================================
# DATABASE (Supabase)
# ===========================================
# Copy from frontend: SUPABASE_URL and SUPABASE_SECRET/SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=
SUPABASE_SECRET=

# ===========================================
# REDIS (Optional - for distributed locking)
# ===========================================
REDIS_URL=

# ===========================================
# NEAR INTENTS / 1CLICK SDK
# ===========================================
# Copy from frontend: NEXT_PUBLIC_ONECLICK_API_BASE, NEXT_PUBLIC_ONECLICK_JWT
ONECLICK_API_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=

# Referral code and app fees
# Copy from frontend: NEXT_PUBLIC_REFERRAL_CODE or NEXT_PUBLIC_ONECLICK_REFERRAL
ONECLICK_REFERRAL=loofta

# Copy from frontend: NEXT_PUBLIC_APP_FEE_BPS, NEXT_PUBLIC_APP_FEE_RECIPIENT
APP_FEE_BPS=30
APP_FEE_RECIPIENT=

# ===========================================
# RHINESTONE
# ===========================================
# Copy from frontend: RHINESTONE_API_KEY or NEXT_PUBLIC_RHINESTONE_API_KEY
RHINESTONE_API_BASE=https://v1.orchestrator.rhinestone.dev
RHINESTONE_API_KEY=

# ===========================================
# RPC URLS
# ===========================================
ETH_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org

# ===========================================
# AUTHENTICATION / ADMIN
# ===========================================
# Comma-separated list of Privy user IDs that have admin access
ADMIN_PRIVY_USER_IDS=

# ===========================================
# CRON JOBS
# ===========================================
# Secret for authenticating cron job requests (optional in dev)
CRON_SECRET=

# Enable automatic claim processing (set to 'false' to disable)
AUTO_PROCESS_CLAIMS=true

# ===========================================
# LOTTERY
# ===========================================
# Ticket automator contract address on Base
TICKET_AUTOMATOR_ADDRESS=0xd1950a138328b52da4fe73dbdb167a83f2c83db9

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,https://pay.loofta.xyz

# ===========================================
# PUBLIC URL
# ===========================================
# Copy from frontend: NEXT_PUBLIC_BASE_URL
NEXT_PUBLIC_BASE_URL=https://pay.loofta.xyz

# ===========================================
# SWAP CONFIGURATION
# ===========================================
# Default slippage in basis points (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100
