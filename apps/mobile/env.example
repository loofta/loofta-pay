# Same backend the web app talks to — mobile calls it directly (no Next.js proxy layer).
# On a physical device, "localhost" resolves to the phone itself, not your machine — use your
# machine's LAN IP instead (e.g. http://192.168.1.x:3001). Android emulators (AVD) can instead
# use the special alias http://10.0.2.2:3001.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001

# Same Privy app as the web (NEXT_PUBLIC_PRIVY_APP_ID in apps/frontend), but @privy-io/expo
# additionally requires a mobile "app client" — create one in the Privy Dashboard under this
# app > Clients, platform "Expo" / "React Native", and put its client ID here.
EXPO_PUBLIC_PRIVY_APP_ID=your-privy-app-id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your-privy-app-client-id
